@using Demo.presentation.ViewModels.Auth
@model ResetPasswordViewModel

@{
    ViewData["Title"] = "ResetPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
} 

<form class="form" asp-action="ResetPassword" asp-controller="Account" method="post">

	<div asp-validation-summary="ModelOnly"></div>

	<p class="title">ResetPassword </p>

	<label>
		<input required="" class="input" asp-for="Password">
		<span>Password</span>
		<span asp-validation-for="Password" class="text-danger"></span>
	</label>

	<label>
		<input required="" class="input" asp-for="ConfirmPassword">
		<span>Confirm Password</span>
		<span asp-validation-for="Password" class="text-danger"></span>
	</label>


	<button type="submit" class="submit" style="cursor:pointer">Submit</button>
</form>

