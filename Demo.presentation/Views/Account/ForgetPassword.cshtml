@using Demo.presentation.ViewModels.Auth

@model ForgetPasswordViewModel
@{
    ViewData["Title"] = "ForgetPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="form-container">
    <div class="logo-container">
        Forgot Password
    </div>

    <form class="form" asp-action="SendResetPasswordLink">
        <div class="form-group">
            <label for="email">Email</label>
            <input asp-for="Email" id="email" name="email" placeholder="Enter your email" style="width: 90%;">
        </div>

        <button class="form-submit-btn" type="submit">Send Email</button>
    </form>

    <p class="signup-link">
        <a asp-action="Login" class="signup-link link"> Cancel</a>
    </p>
</div>
