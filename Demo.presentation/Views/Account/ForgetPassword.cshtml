@using Demo.presentation.ViewModels.Auth
@model ForgetPasswordViewModel

@{
    ViewData["Title"] = "Forget Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="form-container">
    <div class="logo-container">
        Forgot Password
    </div>

    <p class="message">Choose how you'd like to receive the reset link:</p>

    <!-- Reset via Email -->
    <form class="form" asp-action="SendResetPasswordLink" method="post">
        <div class="form-group">
            <label for="email">Email</label>
            <input asp-for="Email" id="email" name="email" placeholder="Enter your email" style="width: 90%;" class="form-control" />
        </div>
        <button class="form-submit-btn" type="submit">Send Reset Link via Email</button>
    </form>

    <hr style="margin: 20px 0;" />

    <!--Reset via SMS -->
    <form class="form" asp-action="SendResetPasswordLinkSms" method="post">
        <div class="form-group">
            <label for="email">Email</label>
            <input asp-for="Email" id="email" name="email" placeholder="Enter your email" style="width: 90%;" class="form-control" />
        </div>
        <button class="form-submit-btn" type="submit">Send Reset Link via SMS</button>
    </form>

    <p class="signup-link">
        <a asp-action="Login" class="signup-link link">Cancel</a>
    </p>
</div>
