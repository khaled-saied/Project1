@using Demo.presentation.ViewModels.Auth
@model ForgetPasswordViewModel

@{
    ViewData["Title"] = "Forget Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-container">
    <div class="auth-card">
        <h2 class="auth-title">Forgot Password</h2>

        <p class="message">Choose how you'd like to receive the reset link:</p>

        <!-- Reset via Email -->
        <form class="auth-form" asp-action="SendResetPasswordLink" method="post">
            <div class="input-group">
                <input asp-for="Email" id="email" name="email" class="auth-input" placeholder="Enter your email" required />
                <label for="email">Email</label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="auth-btn">Send Reset Link via Email</button>
        </form>

        <hr />

        <!-- Reset via SMS -->
        <form class="auth-form" asp-action="SendResetPasswordLinkSms" method="post">
            <div class="input-group">
                <input asp-for="Email" id="email" name="email" class="auth-input" placeholder="Enter your email" required />
                <label for="email">Email</label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="auth-btn">Send Reset Link via SMS</button>
        </form>

        <p class="auth-footer">
            <a asp-action="Login" class="auth-link">Cancel</a>
        </p>
    </div>
</div>
