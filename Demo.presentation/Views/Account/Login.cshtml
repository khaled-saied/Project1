@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-container">
    <div class="auth-card">
        <h2 class="auth-title">Login</h2>

        <form asp-action="Login" method="post" class="auth-form">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="input-group">
                <input asp-for="Email" class="auth-input" placeholder=" " required />
                <label for="Email">Email</label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="input-group">
                <input asp-for="Password" type="password" class="auth-input" placeholder=" " required />
                <label for="Password">Password</label>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="auth-checkbox">
                <label>
                    <input asp-for="RememberMe" />
                    <span>Keep me signed in</span>
                </label>
            </div>

            <button type="submit" class="auth-btn">Sign In</button>

            <a asp-action="GoogleLogin" class="auth-btn google-btn">
                <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google logo" class="google-icon" />
                Sign in with Google
            </a>


            <div class="auth-footer">
                <p>
                    Don't have an account?
                    <a asp-action="Register" asp-controller="Account">Register</a>
                </p>
                <p>
                    <a asp-action="ForgetPassword" asp-controller="Account">Forgot your password?</a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Validation {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
