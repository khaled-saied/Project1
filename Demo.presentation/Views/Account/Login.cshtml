@using Demo.presentation.ViewModels.Auth
@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="form-wrapper">
    <form class="form" asp-action="Login" asp-controller="Account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <p class="title">Sign In</p>
        <p class="message">Sign in now and get full access to our app.</p>

        <label>
            <input required class="input form-control" asp-for="Email" placeholder="Email" />
        </label>

        <label>
            <input required class="input form-control" asp-for="Password" placeholder="Password" />
        </label>

        <div class="form-check mb-3">
            <input class="form-check-input" asp-for="RememberMe" />
            <label class="form-check-label">Remember me</label>
        </div>

        <button type="submit" class="btn btn-signin w-100 mb-3">Sign In</button>


    <a asp-action="GoogleLogin" class="google-btn">
        <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google logo" class="google-icon" />
        Sign in with Google
    </a>

    <div class="text-center mt-4">
        <p>
            Don't have an account?
            <a asp-action="Register" asp-controller="Account">Register</a>
        </p>
        <p>
            <a asp-action="ForgetPassword" asp-controller="Account">Forgot your password?</a>
        </p>
    </div>
        
    </form>

</div>
