@model RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-container">
    <div class="auth-card">
        <h2 class="auth-title">Create Your Account</h2>

        <form asp-action="Register" method="post" asp-controller="Account" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="input-group">
                <input asp-for="FirstName" class="auth-input" placeholder=" " />
                <label for="FirstName">First Name</label>
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="input-group">
                <input asp-for="LastName" class="auth-input" placeholder=" " />
                <label for="LastName">Last Name</label>
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="input-group">
                <input asp-for="UserName" class="auth-input" placeholder=" " />
                <label for="UserName">Username</label>
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="input-group">
                <input asp-for="Email" class="auth-input" placeholder=" " />
                <label for="Email">Email</label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="input-group">
                <input asp-for="Password" type="password" class="auth-input" placeholder=" " />
                <label for="Password">Password</label>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="input-group">
                <input asp-for="ConfirmPassword" type="password" class="auth-input" placeholder=" " />
                <label for="ConfirmPassword">Confirm Password</label>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="auth-checkbox">
                <label>
                    <input asp-for="IsAgree" />
                    <span>I agree to the Terms & Conditions</span>
                </label>
            </div>

            <button type="submit" class="auth-btn">Sign Up</button>
        </form>

        <p class="auth-footer">Already have an account? <a asp-action="Login">Login Now!</a></p>
    </div>
</div>

@section Validation {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
