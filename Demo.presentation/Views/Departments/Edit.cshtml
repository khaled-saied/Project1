@model DepartmentViewModel
@{
    ViewData["Title"] = "Edit Department";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="text-center text-primary mb-4">Edit Department</h2>
            <form method="post" asp-controller="Departments" asp-action="Edit">

                @* Partial View for Create/Edit Form *@
                <partial name="PartialViews/CreateEditPartialView" />

                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-success px-4">Edit</button>
                    <a asp-controller="Departments" asp-action="Index" class="btn btn-outline-dark px-4">Back to list</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
