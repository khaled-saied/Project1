@using Demo.BLL.DataTransferObjects.DepartmentDto
@model DepartmentViewModel
@{
    ViewData["Title"] = "Create";
}

<div class="container mt-5">
    <h1 class="text-center mb-4">Create Department</h1>

    <div class="row justify-content-center align-content-center">
        <form class="col-md-8" method="post" asp-controller="Departments" asp-action="Create">

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

            <!-- Partial View for form fields -->
            <partial name="PartialViews/CreateEditPartialView" />

            <!-- Submit and Back buttons -->
            <div class="mt-4 d-flex justify-content-between">
                <input class="btn btn-primary px-4" type="submit" value="Create" />
                <a class="btn btn-outline-dark px-4" asp-controller="Departments" asp-action="Index">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
