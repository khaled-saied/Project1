@using Demo.DAL.Models.EmployeeModels
@using Demo.DAL.Models.Shared.Enums
@model EmployeeViewModel
@{
    ViewData["Title"] = "Create";
}

<div class="container mt-5">
    <h1 class="text-center mb-4">Create Employee</h1>

    <form method="post" asp-controller="Employees" asp-action="Create" class="row col-md-8 offset-md-2" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <partial name="PartialViews/CreateEditEmployeePartilaView" />

        <div class="mt-4 text-center">
            <input class="btn btn-primary" type="submit" value="Save" />
            <a asp-controller="Employees" asp-action="Index" class="btn btn-outline-dark ml-2">Back to list</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
