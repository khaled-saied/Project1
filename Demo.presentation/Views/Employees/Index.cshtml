@model IEnumerable<EmployeeDto>
@{
    ViewData["Title"] = "Index";
}

<div class="container mt-5">
    <!-- All Employees Title -->
    <div class="text-center mb-4">
        <h1 class="h3 font-weight-bold text-primary">All Employees</h1>
    </div>

    <!-- Create Employee Button -->
    <div class="text-center mb-4">
        <a class="btn btn-primary px-4 py-2" asp-controller="Employees" asp-action="Create">
            <i class="fas fa-plus-circle me-2"></i> Create Employee
        </a>
    </div>

    <!-- Search Form -->
    <div class="mb-4">
        <form asp-action="index" class="row justify-content-center" method="get">
            <div class="col-md-8 mb-3">
                <input class="form-control form-control-md" type="text" name="EmployeeSearchName" placeholder="Search Employee By Name" />
            </div>
            <div class="col-md-4 mb-3">
                <input type="submit" class="btn btn-outline-secondary btn-md w-100" value="Search" />
            </div>
        </form>
    </div>

    <!-- Employee Table -->
    @if (Model.Any())
    {
        <table class="table table-bordered table-hover table-striped mt-4">
            <thead class="table-dark text-center">
                <tr>
                    <th>@Html.DisplayNameFor(e => e.ImageName)</th>
                    <th>@Html.DisplayNameFor(e => e.Name)</th>
                    <th>@Html.DisplayNameFor(e => e.Email)</th>
                    <th>@Html.DisplayNameFor(e => e.EmployeeType)</th>
                    <th>@Html.DisplayNameFor(e => e.Age)</th>
                    <th>@Html.DisplayNameFor(e => e.Department)</th>
                    <th>@Html.DisplayNameFor(e => e.Salary)</th>
                    <th>@Html.DisplayNameFor(e => e.IsActive)</th>
                    <th>@Html.DisplayNameFor(e => e.Gender)</th>
                    <th colspan="3">Actions</th>
                </tr>
            </thead>
            <tbody class="text-center">
                @foreach (var employee in Model)
                {
                    <tr>
                        <!-- Employee Image -->
                        <td>
                            @if (string.IsNullOrEmpty(employee.ImageName))
                            {
                                <text>No Image</text>
                            }
                            else
                            {
                                <div class="mb-3">
                                    <img src="~/Files/Images/@employee.ImageName" alt="Employee Image" class="rounded-circle" style="width: 70px; height: 70px; object-fit: cover;" />
                                </div>
                            }
                        </td>

                        <td>@employee.Name</td>
                        <td>@employee.Email</td>
                        <td>@employee.EmployeeType</td>
                        <td>@employee.Age</td>
                        <td>@(string.IsNullOrEmpty(@employee.Department) ? "No Department" : employee.Department)</td>
                        <td>@Html.DisplayFor(E => employee.Salary)</td>

                        <!-- Employee Status -->
                        <td>
                            <i class="fa @(employee.IsActive ? "fa-solid fa-circle-check text-success" : "fa-solid fa-circle-xmark text-danger")"></i>
                        </td>
                        <td>@employee.Gender</td>

                        <!-- Details Button -->
                        <td>
                            <a href="@Url.Action("Details", "Employees", new { id = employee.Id })" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-info-circle"></i> Details
                            </a>
                        </td>

                        <!-- Edit Button -->
                        <td>
                            <a href="@Url.Action("Edit", "Employees", new { id = employee.Id })" class="btn btn-outline-warning btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                        </td>

                        <!-- Delete Button & Modal -->
                        <td>
                            <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal-@employee.Id">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                            <div class="modal fade" id="deleteModal-@employee.Id" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h1 class="modal-title fs-5" id="exampleModalLabel">Delete Employee</h1>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            Are You Sure to Delete this Employee with Name @employee.Name?
                                        </div>
                                        <div class="modal-footer">
                                            <form method="post" asp-action="Delete" asp-controller="Employees" asp-route-id="@employee.Id">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                <input type="submit" value="Delete" class="btn btn-danger" />
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info mt-3">
            <h2>No Employees Found!</h2>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
